# Placeholders only. Real values live in .env.local (written by `neon link` /
# `neon deploy` for the Neon ones) and in Vercel's environment settings.

# Neon Postgres: pooled for the app, direct for the Prisma CLI.
DATABASE_URL=postgresql://user:password@host-pooler/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/neondb?sslmode=require

# Neon Auth.
NEON_AUTH_BASE_URL=https://example.neonauth.example/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-with-openssl-rand-base64-32

# Neon Object Storage (S3-compatible).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://storage.example
AWS_REGION=eu-central-1

# Check pipeline (src/lib/env.server.ts `getPipelineEnv`).
STEEL_API_KEY=
GOOGLE_AI_API_KEY=
JEV_API_KEY=

# Vercel Cron bearer token for /api/cron/*; at least 16 characters.
CRON_SECRET=

# Neon Auth user ID of "Anonimni korisnik", who owns the extension's reviews (ADR 0014).
EXTENSION_ANONYMOUS_USER_ID=
